<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares Nerdigy.Mediator with MediatR and martinothamar/Mediator. Kept out of the main benchmark project so the
       repository's own benchmarks do not depend on other mediator packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Mediator.SourceGenerator emits code this repository's analyzer settings do not govern. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nerdigy.Mediator.DependencyInjection\Nerdigy.Mediator.DependencyInjection.csproj" />
  </ItemGroup>

</Project>